
{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User's basic profile information.",
      "type": "object",
      "properties": {
        "fullName": { "type": "string" },
        "email": { "type": "string" },
        "secondaryEmail": { "type": "string" },
        "phone": { "type": "string" },
        "address": { "type": "string" },
        "website": { "type": "string" },
        "gender": { "type": "string" },
        "bio": { "type": "string" },
        "avatarUrl": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "Job": {
      "title": "Job",
      "type": "object",
      "properties": {
        "company": { "type": "string" },
        "role": { "type": "string" },
        "joiningDate": { "type": "string" },
        "endDate": { "type": "string" },
        "employmentType": { "type": "string" },
        "workSetting": { "type": "string" },
        "userId": { "type": "string" }
      }
    },
    "Experience": {
      "title": "Experience",
      "type": "object",
      "properties": {
        "company": { "type": "string" },
        "title": { "type": "string" },
        "location": { "type": "string" },
        "startDate": { "type": "string" },
        "endDate": { "type": "string" },
        "description": { "type": "string" },
        "userId": { "type": "string" }
      }
    },
    "Project": {
      "title": "Project",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "url": { "type": "string" },
        "imageUrl": { "type": "string" },
        "documentUrl": { "type": "string" },
        "documentName": { "type": "string" },
        "date": { "type": "string" },
        "category": { "type": "string", "enum": ["project", "product"] },
        "userId": { "type": "string" }
      }
    },
    "Education": {
      "title": "Education",
      "type": "object",
      "properties": {
        "institution": { "type": "string" },
        "degree": { "type": "string" },
        "fieldOfStudy": { "type": "string" },
        "startDate": { "type": "string" },
        "endDate": { "type": "string" },
        "description": { "type": "string" },
        "cgpa": { "type": "string" },
        "percentage": { "type": "string" },
        "idNumber": { "type": "string" },
        "userId": { "type": "string" }
      }
    },
    "PortfolioLink": {
      "title": "PortfolioLink",
      "type": "object",
      "properties": {
        "platform": { "type": "string" },
        "url": { "type": "string" },
        "userId": { "type": "string" }
      }
    }
  },
  "auth": {
    "providers": ["password"]
  },
  "firestore": {
    "/users/{uid}/profile": {
      "schema": { "$ref": "#/backend/entities/UserProfile" }
    },
    "/users/{uid}/jobs/{jobId}": {
      "schema": { "$ref": "#/backend/entities/Job" }
    },
    "/users/{uid}/experience/{expId}": {
      "schema": { "$ref": "#/backend/entities/Experience" }
    },
    "/users/{uid}/projects/{projId}": {
      "schema": { "$ref": "#/backend/entities/Project" }
    },
    "/users/{uid}/education/{eduId}": {
      "schema": { "$ref": "#/backend/entities/Education" }
    },
    "/users/{uid}/portfolioLinks/{linkId}": {
      "schema": { "$ref": "#/backend/entities/PortfolioLink" }
    },
    "/shared-profiles/{uid}": {
      "rules": "allow read: if true; allow write: if request.auth.uid == uid;"
    },
    "/shared-profiles/{uid}/{subcollection}/{docId}": {
      "rules": "allow read: if true; allow write: if request.auth.uid == uid;"
    }
  }
}
