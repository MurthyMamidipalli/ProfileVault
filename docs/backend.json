
{
  "entities": {
    "SharedProfile": {
      "title": "SharedProfile",
      "description": "A publicly accessible professional profile snapshot.",
      "type": "object",
      "properties": {
        "profileData": {
          "type": "object",
          "description": "The full user profile data."
        },
        "ownerId": {
          "type": "string"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  },
  "auth": {
    "providers": ["password"]
  },
  "firestore": {
    "/shared-profiles/{uid}": {
      "schema": { "$ref": "#/backend/entities/SharedProfile" },
      "description": "The primary source of truth for user profiles, keyed by Auth UID."
    }
  }
}
